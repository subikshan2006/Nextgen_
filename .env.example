# Copy to .env for local development (never commit .env)

# Local dev DB (Vercel uses Neon Postgres via DATABASE_URL in Vercel dashboard)
DATABASE_URL=sqlite:///./nextgen.db

# Random long string for JWT signing
JWT_SECRET=change-me-to-a-long-random-string

# Your machine's Ollama (deployed site uses a tunnel URL here)
OLLAMA_URL=http://localhost:11434

# Default chat model
DEFAULT_MODEL=nextgen-trained

# Bootstrap admin (created on first startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME
